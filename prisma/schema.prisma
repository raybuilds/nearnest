generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Corridor {
  id           Int           @id @default(autoincrement())
  name         String
  cityCode     Int           @default(0)
  students     Student[]
  units        Unit[]
  institutions Institution[]
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String
  createdAt DateTime  @default(now())
  student   Student?
  landlord  Landlord?
  parent    Parent?
  uploadedMedia UnitMedia[]
  alerts    Alert[]
}

model Student {
  id         Int        @id @default(autoincrement())
  name       String
  intake     String
  userId     Int?       @unique
  institutionId Int?
  corridor   Corridor   @relation(fields: [corridorId], references: [id])
  corridorId Int
  user       User?      @relation(fields: [userId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])
  complaints Complaint[]
  vdpEntries VDPEntry[]
  occupancies Occupancy[]
  occupants  Occupant[]
  shortlists Shortlist[]
  guardians  ParentStudent[]
}

model Landlord {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
  units  Unit[]
}

model Parent {
  id          Int             @id @default(autoincrement())
  userId      Int             @unique
  user        User            @relation(fields: [userId], references: [id])
  phoneNumber String
  students    ParentStudent[]
}

model ParentStudent {
  id        Int      @id @default(autoincrement())
  parentId  Int
  studentId Int
  verified  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Parent   @relation(fields: [parentId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model Unit {
  id                          Int        @id @default(autoincrement())
  status                      UnitStatus @default(draft)
  trustScore                  Float      @default(75)
  rent                        Int        @default(0)
  distanceKm                  Float      @default(0)
  institutionProximityKm      Float      @default(0)
  ac                          Boolean    @default(false)
  occupancyType               String     @default("unknown")
  bedAvailable                Boolean    @default(true)
  waterAvailable              Boolean    @default(true)
  toiletsAvailable            Int        @default(1)
  ventilationGood             Boolean    @default(true)
  capacity                    Int        @default(1)
  structuralApproved          Boolean    @default(false)
  operationalBaselineApproved Boolean    @default(false)
  auditRequired               Boolean    @default(false)
  falseDeclarationCount       Int        @default(0)
  landlordId                  Int?
  corridor                    Corridor   @relation(fields: [corridorId], references: [id])
  landlord                    Landlord?  @relation(fields: [landlordId], references: [id])
  corridorId                  Int
  complaints                  Complaint[]
  occupancies                 Occupancy[]
  occupants                   Occupant[]
  shortlists                  Shortlist[]
  structuralChecklist         StructuralChecklist?
  operationalChecklist        OperationalChecklist?
  media                       UnitMedia[]
  auditLogs                   AuditLog[]
  compliances                 UnitCompliance[]
}

enum UnitStatus {
  draft
  submitted
  admin_review
  approved
  suspended
  rejected
  archived
}

model Complaint {
  id          Int       @id @default(autoincrement())
  severity    Int
  message     String?
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  slaDeadline DateTime?
  incidentType String?
  incidentFlag Boolean   @default(false)
  unit        Unit      @relation(fields: [unitId], references: [id])
  unitId      Int
  occupantRecordId Int?
  occupant    Occupant? @relation(fields: [occupantRecordId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
  studentId   Int
}

model VDPEntry {
  id         Int     @id @default(autoincrement())
  studentId  Int
  corridorId Int
  intake     String
  verified   Boolean @default(true)
  status     String  @default("verified")
  joinedAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
}

model Shortlist {
  id        Int      @id @default(autoincrement())
  studentId Int
  unitId    Int
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  unit      Unit     @relation(fields: [unitId], references: [id])
}

model Institution {
  id         Int       @id @default(autoincrement())
  name       String
  corridorId Int
  corridor   Corridor  @relation(fields: [corridorId], references: [id])
  students   Student[]
}

model Occupancy {
  id         Int         @id @default(autoincrement())
  unitId     Int
  studentId  Int
  startDate  DateTime    @default(now())
  endDate    DateTime?
  unit       Unit        @relation(fields: [unitId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])
  guestStays GuestStay[]
  payments   Payment[]
  agreements Agreement[]
}

model Payment {
  id          Int            @id @default(autoincrement())
  occupancyId Int
  amount      Int
  month       String         // Format: YYYY-MM
  status      PaymentStatus  @default(PENDING)
  receiptRef  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  occupancy   Occupancy      @relation(fields: [occupancyId], references: [id])
  audits      PaymentAudit[]

  @@unique([occupancyId, month])
  @@index([status])
  @@index([occupancyId])
}

model PaymentAudit {
  id        Int      @id @default(autoincrement())
  paymentId Int
  actorId   Int      // User.id of the person making the change
  action    String   // e.g. "STATUS_CHANGE", "CORRECTION"
  changes   Json?    // e.g. {"status": {"old": "PAID", "new": "VERIFIED"}}
  reason    String?
  requestId String?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([actorId])
}

enum PaymentStatus {
  PENDING
  PAID
  VERIFIED
}

model GuestStay {
  id           Int       @id @default(autoincrement())
  guestName    String
  occupancyId  Int
  startDate    DateTime  @default(now())
  endDate      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  occupancy    Occupancy @relation(fields: [occupancyId], references: [id])

  @@index([occupancyId])
  @@index([active])
}

model Occupant {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique
  cityCode      Int
  corridorCode  Int
  hostelCode    Int
  roomNumber    Int
  occupantIndex Int
  studentId     Int
  unitId        Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  student       Student  @relation(fields: [studentId], references: [id])
  unit          Unit     @relation(fields: [unitId], references: [id])
  complaints    Complaint[]

  @@unique([unitId, roomNumber, occupantIndex, active])
  @@index([studentId, active])
  @@index([unitId, active])
  @@index([unitId, roomNumber, active])
}

model StructuralChecklist {
  id                 Int      @id @default(autoincrement())
  unitId             Int      @unique
  fireExit           Boolean  @default(false)
  wiringSafe         Boolean  @default(false)
  plumbingSafe       Boolean  @default(false)
  occupancyCompliant Boolean  @default(false)
  approved           Boolean  @default(false)
  unit               Unit     @relation(fields: [unitId], references: [id])
}

model OperationalChecklist {
  id                Int      @id @default(autoincrement())
  unitId            Int      @unique
  bedAvailable      Boolean  @default(false)
  waterAvailable    Boolean  @default(false)
  toiletsAvailable  Boolean  @default(false)
  ventilationGood   Boolean  @default(false)
  selfDeclaration   String?
  approved          Boolean  @default(false)
  unit              Unit     @relation(fields: [unitId], references: [id])
}

model UnitMedia {
  id        Int      @id @default(autoincrement())
  unitId    Int
  type      MediaType
  storageKey String
  publicUrl String
  fileName  String
  mimeType  String
  sizeInBytes Int
  uploadedById Int
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  unit      Unit     @relation(fields: [unitId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
}

enum MediaType {
  photo
  document
  walkthrough360
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  unitId    Int
  triggerType String @default("manual")
  reason    String
  correctiveAction String?
  correctiveDeadline DateTime?
  verificationNotes String?
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)
  resolvedAt DateTime?
  unit      Unit     @relation(fields: [unitId], references: [id])
}

model Agreement {
  id               Int             @id @default(autoincrement())
  occupancyId      Int
  version          Int             @default(1)
  status           AgreementStatus @default(DRAFT)
  rentAmount       Int
  securityDeposit  Int
  noticePeriodDays Int             @default(30)
  startDate        DateTime
  endDate          DateTime
  documentPath     String?
  tenantSigned     Boolean         @default(false)
  tenantSignedAt   DateTime?
  landlordSigned   Boolean         @default(false)
  landlordSignedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  occupancy        Occupancy       @relation(fields: [occupancyId], references: [id])

  @@unique([occupancyId, version])
  @@index([occupancyId])
  @@index([status])
}

model UnitCompliance {
  id         Int              @id @default(autoincrement())
  unitId     Int
  docType    String
  storageKey String
  fileName   String
  expiryDate DateTime?
  status     ComplianceStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  unit       Unit             @relation(fields: [unitId], references: [id])
  audits     ComplianceAudit[]

  @@index([unitId])
  @@index([status])
}

model ComplianceAudit {
  id             Int              @id @default(autoincrement())
  complianceId   Int
  actorId        Int
  action         String
  previousStatus ComplianceStatus
  newStatus      ComplianceStatus
  reason         String?
  requestId      String?
  createdAt      DateTime         @default(now())

  compliance     UnitCompliance   @relation(fields: [complianceId], references: [id])

  @@index([complianceId])
  @@index([actorId])
}

enum AgreementStatus {
  DRAFT
  PENDING_TENANT
  PENDING_LANDLORD
  ACTIVE
  EXPIRED
  TERMINATED
  SUPERSEDED
}

enum ComplianceStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AlertStatus {
  OPEN
  READ
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
  EXPIRED
}

model Alert {
  id             Int          @id @default(autoincrement())
  recipientId    Int
  eventKey       String       // Non-null deterministic identity key
  type           String       // e.g. "COMPLIANCE_EXPIRING", "PAYMENT_OVERDUE"
  severity       String       // INFO, LOW, MEDIUM, HIGH, CRITICAL
  status         AlertStatus  @default(OPEN)
  
  // Relations to existing entities (NULL if not applicable)
  unitId         Int?
  occupancyId    Int?
  paymentId      Int?
  agreementId    Int?
  guestStayId    Int?
  complaintId    Int?

  title          String
  message        String
  metadata       Json?        // Optional key-value context
  
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  resolvedAt     DateTime?
  expiresAt      DateTime?

  recipient      User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([createdAt])
  @@unique([recipientId, eventKey]) // Guarantees robust idempotency
}
